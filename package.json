{
  "name": "cyberante",
  "version": "0.1.0",
  "description": "CYBERANTE - Procedural Vector Poker-Combat Matrix (Handshake x OpenAI Challenge)",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev:server": "npm --workspace=packages/server run dev",
    "dev:client": "npm --workspace=packages/client run dev",
    "build": "npm --workspace=packages/shared run build && npm --workspace=packages/server run build && npm --workspace=packages/client run build",
    "start": "npm --workspace=packages/server run start",
    "test": "npm --workspace=packages/server test && npm --workspace=packages/client test",
    "sim": "npm --workspace=packages/server run sim",
    "test:e2e": "npm run build && playwright test",
    "verify:build": "node scripts/verifyBuild.mjs",
    "benchmark": "node scripts/rendererBenchmark.mjs",
    "test:math:coverage": "vitest run --config vitest.math.config.mts && node scripts/verifyMathCoverage.mjs"
  },
  "keywords": [
    "poker",
    "fighting-game",
    "neon-vector",
    "procedural",
    "webgl",
    "webaudio",
    "threejs",
    "websockets",
    "openai-codex"
  ],
  "author": "Blaze Giroux",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
